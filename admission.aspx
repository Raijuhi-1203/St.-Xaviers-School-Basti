<%@ Page Title="Admissions 2026-27 | St. Xavier's Senior Secondary School Basti" Language="C#" MasterPageFile="~/MasterPage.master" AutoEventWireup="true" CodeFile="admission.aspx.cs" Inherits="admission" %>

<asp:Content ID="Content1" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">

    <!-- Inner Page Hero Banner Start -->
    <div class="inner-page-banner">
        <div class="container px-4 px-lg-5">
            <div class="row align-items-center g-4">
                <div class="col-lg-8 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="mb-3">
                        <nav aria-label="breadcrumb">
                            <div class="inner-breadcrumb">
                                <a href="index.aspx"><i class="fas fa-home me-1"></i> Home</a>
                                <span class="text-white-50">/</span>
                                <span class="text-white-50">Admissions</span>
                                <span class="text-white-50">/</span>
                                <span class="text-white">Admissions 2026-27</span>
                            </div>
                        </nav>
                    </div>
                    <span class="banner-tag"><i class="fas fa-user-graduate me-1"></i> Session 2026-2027 Open</span>
                    <h1 class="mb-3">Admissions Open (Nursery to Class IX &amp; XI)</h1>
                    <p class="inner-banner-subtitle mb-4">
                        Begin your child's journey at St. Xavier's Senior Secondary School, Basti - celebrating 25+ years of CBSE academic excellence, discipline, and holistic growth.
                    </p>
                    <div class="d-flex gap-3 flex-wrap">
                        <a href="#enquiry-form" class="btn btn-gold fw-bold shadow-sm">
                            <i class="fas fa-pen-nib me-2"></i> Fill Enquiry Form
                        </a>
                        <a href="tel:+919792277113" class="btn btn-outline-light fw-bold">
                            <i class="fas fa-phone-alt me-2"></i> +91-9792277113
                        </a>
                    </div>
                </div>
                <div class="col-lg-4 d-none d-lg-block wow fadeInUp" data-wow-delay="0.2s">
                    <div class="inner-hero-card">
                        <div class="inner-hero-card-item">
                            <div class="inner-hero-card-icon"><i class="fas fa-calendar-check"></i></div>
                            <div>
                                <small class="text-gold fw-bold text-uppercase d-block" style="font-size: 11px;">Open Classes</small>
                                <span class="text-white fw-bold small">Nursery to IX &amp; XI (Science / Commerce)</span>
                            </div>
                        </div>
                        <div class="inner-hero-card-item">
                            <div class="inner-hero-card-icon"><i class="fas fa-clock"></i></div>
                            <div>
                                <small class="text-gold fw-bold text-uppercase d-block" style="font-size: 11px;">Admission Office</small>
                                <span class="text-white fw-bold small">Mon - Sat : 8:00 AM - 2:30 PM</span>
                            </div>
                        </div>
                        <div class="inner-hero-card-item">
                            <div class="inner-hero-card-icon"><i class="fas fa-headset"></i></div>
                            <div>
                                <small class="text-gold fw-bold text-uppercase d-block" style="font-size: 11px;">Helpdesk</small>
                                <span class="text-white fw-bold small">+91-9792277113</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Inner Page Hero Banner End -->

    <!-- 4-Step Admission Process Start -->
    <div class="container-xxl py-5">
        <div class="container">
            <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
                <h6 class="section-title bg-white text-center text-primary px-3">Step-by-Step Guide</h6>
                <h1 class="mb-5">Admission Process (2026-27)</h1>
            </div>

            <div class="row g-4">
                <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="feature-pillar-card text-center">
                        <div class="feature-icon-wrapper"><i class="fas fa-edit"></i></div>
                        <span class="value-number-tag">Step 01</span>
                        <h5 class="mb-2">Enquiry &amp; Registration</h5>
                        <p class="text-muted small mb-0">
                            Submit the online admission enquiry form or collect the registration prospectus from the school office.
                        </p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay="0.2s">
                    <div class="feature-pillar-card card-crimson text-center">
                        <div class="feature-icon-wrapper text-secondary" style="border-color: #F8D7DA; background: #FFF5F5;"><i class="fas fa-comments"></i></div>
                        <span class="value-number-tag text-secondary" style="background:#FFF0F0;">Step 02</span>
                        <h5 class="mb-2">Interaction / Assessment</h5>
                        <p class="text-muted small mb-0">
                            Informal child interaction for Pre-Primary and baseline entrance interaction for Classes I to IX &amp; XI.
                        </p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay="0.3s">
                    <div class="feature-pillar-card card-gold text-center">
                        <div class="feature-icon-wrapper text-gold" style="border-color: #FEEBC8; background: #FFFAF0;"><i class="fas fa-folder-open"></i></div>
                        <span class="value-number-tag text-gold" style="background:#FFFAF0;">Step 03</span>
                        <h5 class="mb-2">Document Verification</h5>
                        <p class="text-muted small mb-0">
                            Submission and verification of birth certificate, previous school TC, report card, and identity records.
                        </p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay="0.4s">
                    <div class="feature-pillar-card text-center">
                        <div class="feature-icon-wrapper"><i class="fas fa-check-double"></i></div>
                        <span class="value-number-tag">Step 04</span>
                        <h5 class="mb-2">Seat Confirmation</h5>
                        <p class="text-muted small mb-0">
                            Completion of admission fee formalities at the school counter and allotment of section &amp; bus route.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- 4-Step Admission Process End -->

    <!-- Eligibility & Documents Checklist Start -->
    <div class="container-xxl py-5 bg-light-blue">
        <div class="container">
            <div class="row g-4 align-items-stretch">
                <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="desk-message-box h-100">
                        <h6 class="section-title bg-white text-start text-primary pe-3 mb-3">Eligibility Norms</h6>
                        <h3 class="mb-4">Age &amp; Class Eligibility</h3>
                        <ul class="list-unstyled mb-0">
                            <li class="d-flex align-items-start mb-3">
                                <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                                <span class="text-muted"><strong>Nursery / LKG / UKG:</strong> Age criteria aligned with CBSE / NEP foundational stage norms as on 31st March of the academic year.</span>
                            </li>
                            <li class="d-flex align-items-start mb-3">
                                <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                                <span class="text-muted"><strong>Classes I to IX:</strong> Successful completion of the preceding class from a recognized school and baseline interaction.</span>
                            </li>
                            <li class="d-flex align-items-start mb-0">
                                <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                                <span class="text-muted"><strong>Class XI (Science / Commerce):</strong> Based on Class X Board / Pre-Board performance and stream aptitude counseling.</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.3s">
                    <div class="desk-message-box crimson-top h-100">
                        <h6 class="section-title bg-white text-start text-primary pe-3 mb-3">Required Records</h6>
                        <h3 class="mb-4">Documents Required at Admission</h3>
                        <ul class="list-unstyled mb-0">
                            <li class="d-flex align-items-start mb-3">
                                <i class="fas fa-file-alt text-secondary mt-1 me-3"></i>
                                <span class="text-muted">Municipal Birth Certificate (for Pre-Primary &amp; Class I admissions).</span>
                            </li>
                            <li class="d-flex align-items-start mb-3">
                                <i class="fas fa-file-alt text-secondary mt-1 me-3"></i>
                                <span class="text-muted">Original Transfer Certificate (TC) &amp; previous class Report Card (for Class II &amp; above).</span>
                            </li>
                            <li class="d-flex align-items-start mb-3">
                                <i class="fas fa-file-alt text-secondary mt-1 me-3"></i>
                                <span class="text-muted">Passport-size photographs of Student and Parents/Guardians.</span>
                            </li>
                            <li class="d-flex align-items-start mb-0">
                                <i class="fas fa-file-alt text-secondary mt-1 me-3"></i>
                                <span class="text-muted">Aadhaar Card copy of student &amp; parents (for CBSE registration records).</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Eligibility & Documents Checklist End -->

    <!-- Admission Enquiry Form Start -->
    <div class="container-xxl py-5" id="enquiry-form">
        <div class="container">
            <div class="admission-cta-banner wow fadeInUp" data-wow-delay="0.1s">
                <div class="row align-items-center g-4">
                    <div class="col-lg-6">
                        <span class="badge bg-gold text-dark fw-bold px-3 py-2 mb-3 text-uppercase">
                            <i class="fas fa-calendar-check me-1"></i> Academic Session 2026-2027
                        </span>
                        <h2 class="text-white mb-3" style="font-size: 2.2rem; font-weight: 800;">
                            Submit Your Admission Enquiry
                        </h2>
                        <p class="text-white-50 mb-4" style="line-height: 1.7;">
                            Fill out the enquiry form and our Admission Counselor at <strong>St. Xavier's Senior Secondary School, Basti</strong> will connect with you regarding registration dates, stream options, and bus routes.
                        </p>
                        <div class="d-flex gap-3 flex-wrap">
                            <a href="tel:+919792277113" class="btn btn-gold fw-bold shadow">
                                <i class="fas fa-phone-alt me-2"></i> +91-9792277113
                            </a>
                            <a href="mailto:xaviersbasti@gmail.com" class="btn btn-outline-light fw-bold">
                                <i class="fas fa-envelope me-2"></i> xaviersbasti@gmail.com
                            </a>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="bg-white p-4 rounded-3 shadow text-dark">
                            <h4 class="text-primary mb-2 text-center">Admission Enquiry Form</h4>
                            <p class="text-muted small text-center mb-3">Our admission desk responds within 1 working day.</p>
                            <div class="row g-2">
                                <div class="col-12">
                                    <asp:TextBox ID="name" runat="server" type="text" class="form-control" placeholder="Student's Full Name" required></asp:TextBox>
                                </div>
                                <div class="col-md-6">
                                    <asp:TextBox ID="number" runat="server" type="text" class="form-control" placeholder="Parent Contact No." required></asp:TextBox>
                                </div>
                                <div class="col-md-6">
                                    <asp:DropDownList ID="dblclass" class="form-select" runat="server">
                                        <asp:ListItem>Class Seeking...</asp:ListItem>
                                        <asp:ListItem>Pre-Primary (Nursery/KG)</asp:ListItem>
                                        <asp:ListItem>Class I - V</asp:ListItem>
                                        <asp:ListItem>Class VI - VIII</asp:ListItem>
                                        <asp:ListItem>Class IX - X</asp:ListItem>
                                        <asp:ListItem>Class XI (Science)</asp:ListItem>
                                        <asp:ListItem>Class XI (Commerce)</asp:ListItem>
                                    </asp:DropDownList>
                                </div>
                                <div class="col-12">
                                    <asp:TextBox ID="email" runat="server" type="email" class="form-control" placeholder="Email Address" required></asp:TextBox>
                                </div>
                                <div class="col-12">
                                    <asp:TextBox ID="message" runat="server" TextMode="MultiLine" Rows="2" class="form-control" placeholder="Any query or residential area in Basti..." required></asp:TextBox>
                                </div>
                                <div class="col-12 mt-3">
                                    <button id="btnsend" runat="server" onserverclick="btnsend_ServerClick" type="button" class="btn btn-secondary w-100 fw-bold py-2 shadow-sm">
                                        <i class="fas fa-paper-plane me-1"></i> Submit Admission Enquiry
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Admission Enquiry Form End -->

</asp:Content>
