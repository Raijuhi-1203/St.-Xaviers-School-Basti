    <!-- Six Core Parent Guidelines Start -->
    <div class="container-xxl py-5">
        <div class="container">
            <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
                <h6 class="section-title bg-white text-center text-primary px-3">Shared Responsibility</h6>
                <h1 class="mb-5">Essential Guidelines for Parents</h1>
            </div>

            <div class="row g-4">
                <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="feature-pillar-card">
                        <div class="feature-icon-wrapper"><i class="fas fa-user-clock"></i></div>
                        <h5 class="mb-2">Punctuality &amp; Attendance</h5>
                        <p class="text-muted small mb-0">
                            Ensure your ward reaches school before the assembly bell. Maintain at least 75% attendance and avoid unnecessary leaves during academic sessions.
                        </p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.2s">
                    <div class="feature-pillar-card card-crimson">
                        <div class="feature-icon-wrapper text-secondary" style="border-color: #F8D7DA; background: #FFF5F5;"><i class="fas fa-tshirt"></i></div>
                        <h5 class="mb-2">Uniform &amp; Grooming</h5>
                        <p class="text-muted small mb-0">
                            Students must wear neat, prescribed summer/winter uniforms with polished shoes, school belt, and ID card every day.
                        </p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.3s">
                    <div class="feature-pillar-card card-gold">
                        <div class="feature-icon-wrapper text-gold" style="border-color: #FEEBC8; background: #FFFAF0;"><i class="fas fa-book-open"></i></div>
                        <h5 class="mb-2">Almanac &amp; Daily Review</h5>
                        <p class="text-muted small mb-0">
                            Check the student diary/almanac daily for teacher remarks, circulars, and homework, and sign acknowledgements promptly.
                        </p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.4s">
                    <div class="feature-pillar-card card-gold">
                        <div class="feature-icon-wrapper text-gold" style="border-color: #FEEBC8; background: #FFFAF0;"><i class="fas fa-chalkboard-teacher"></i></div>
                        <h5 class="mb-2">Parent-Teacher Meetings</h5>
                        <p class="text-muted small mb-0">
                            Attending scheduled PTMs is vital to understand academic progress, classroom participation, and personal development.
                        </p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.5s">
                    <div class="feature-pillar-card">
                        <div class="feature-icon-wrapper"><i class="fas fa-apple-alt"></i></div>
                        <h5 class="mb-2">Healthy Tiffin &amp; Wellness</h5>
                        <p class="text-muted small mb-0">
                            Pack nutritious home-cooked food and a clean water bottle. Do not send sick children to school; submit a medical note upon return.
                        </p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.6s">
                    <div class="feature-pillar-card card-crimson">
                        <div class="feature-icon-wrapper text-secondary" style="border-color: #F8D7DA; background: #FFF5F5;"><i class="fas fa-bus"></i></div>
                        <h5 class="mb-2">Transport &amp; Pick-Up Safety</h5>
                        <p class="text-muted small mb-0">
                            Parents picking up wards personally must carry the guardian ID card. Inform the office in advance for any change in bus stop or escort.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Six Core Parent Guidelines End -->

    <!-- Communication & Campus Etiquette Start -->
    <div class="container-xxl py-5 bg-light-blue">
        <div class="container">
            <div class="row g-4 align-items-stretch">
                <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="info-fact-card p-4">
                        <h4 class="text-primary mb-3"><i class="fas fa-comments text-gold me-2"></i>Communication &amp; Campus Visits</h4>
                        <ul class="list-unstyled mb-0">
                            <li class="d-flex align-items-start mb-3">
                                <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                                <span class="text-muted">Parents are requested not to enter classrooms during teaching hours; meet teachers only during designated visiting windows or PTMs.</span>
                            </li>
                            <li class="d-flex align-items-start mb-3">
                                <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                                <span class="text-muted">Any change in residential address or parent phone number must be updated at the school office immediately for emergency alerts.</span>
                            </li>
                            <li class="d-flex align-items-start mb-0">
                                <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                                <span class="text-muted">Half-day leave during school hours is permitted only in genuine emergencies with written authorization from the Principal's office.</span>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.3s">
                    <div class="info-fact-card fact-crimson p-4">
                        <h4 class="text-secondary mb-3"><i class="fas fa-ban text-gold me-2"></i>Items &amp; Conduct Restrictions</h4>
                        <ul class="list-unstyled mb-0">
                            <li class="d-flex align-items-start mb-3">
                                <i class="fas fa-check-circle text-secondary mt-1 me-3"></i>
                                <span class="text-muted">Mobile phones, expensive gadgets, smartwatches, or large amounts of cash are strictly prohibited on campus.</span>
                            </li>
                            <li class="d-flex align-items-start mb-3">
                                <i class="fas fa-check-circle text-secondary mt-1 me-3"></i>
                                <span class="text-muted">Students must not drive two-wheelers or cars to school without a valid government driving license as per safety law.</span>
                            </li>
                            <li class="d-flex align-items-start mb-0">
                                <i class="fas fa-check-circle text-secondary mt-1 me-3"></i>
                                <span class="text-muted">Any damage to school property, laboratory apparatus, or library books will be compensated by the guardian.</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Communication & Campus Etiquette End -->

    <!-- CTA Banner Start -->
