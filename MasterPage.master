                            <a href="#admission" class="text-gold fw-bold text-decoration-none small"><i class="fas fa-user-graduate me-1"></i> Admissions 2026-27</a>
                            <span class="text-white-50">|</span>
                            <div class="d-inline-flex gap-2">
                                <a class="text-white-50 hover-gold" href="https://share.google/wbhwX2RnjxrF8vXia" target="_blank" title="Facebook"><i class="fas fa-location-arrow"></i></a>
